local function newSlider(label, min, max, def, order, cb)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -10, 0, 52)
    f.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
    f.BorderSizePixel = 0
