-- ========== ESP ==========
local ESPCache = {}

local function makeESP(p)
    local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local box = Instance.new("BoxHandleAdornment")
    box.Size = Vector3.new(3, 5, 1)
    box.Color3 = Config.ESPColor
    box.Transparency = 0.5
    box.AlwaysOnTop = true
    box.Adornee = hrp
    box.Parent = hrp

    local bill = Instance.new("BillboardGui")
    bill.Size = UDim2.new(0, 120, 0, 40)
    bill.Adornee = hrp
    bill.StudsOffset = Vector3.new(0, 3, 0)
    bill.Parent = hrp

    local name = Instance.new("TextLabel")
    name.Size = UDim2.new(1, 0, 0.5, 0)
    name.BackgroundTransparency = 1
    name.Text = p.Name
    name.TextColor3 = Config.ESPColor
    name.Font = Enum.Font.GothamBold
    name.TextSize = 12
    name.Parent = bill

    local hp = Instance.new("TextLabel")
    hp.Size = UDim2.new(1, 0, 0.5, 0)
    hp.Position = UDim2.new(0, 0, 0.5, 0)
    hp.BackgroundTransparency = 1
    hp.TextColor3 = Color3.fromRGB(255, 120, 120)
    hp.Font = Enum.Font.Gotham
    hp.TextSize = 10
    hp.Parent = bill

    ESPCache[p] = {box = box, bill = bill, hp = hp}
end

local function clearESP()
    for _, v in pairs(ESPCache) do
        if v.box then v.box:Destroy() end
        if v.bill then v.bill:Destroy() end
    end
    ESPCache = {}
end

RunService.Heartbeat:Connect(function()
    if not Config.ESP then
        if next(ESPCache) then clearESP() end
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if not ESPCache[p] then makeESP(p) end
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and ESPCache[p].hp then
                ESPCache[p].hp.Text = math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
            end
            local hrp = p.Character.HumanoidRootPart
            local sp, on = Camera:WorldToViewportPoint(hrp.Position)
            local visible = on and sp.Z > 0
            if ESPCache[p].box then ESPCache[p].box.Visible = visible end
            if ESPCache[p].bill then ESPCache[p].bill.Enabled = visible end
        else
            if ESPCache[p] then
                if ESPCache[p].box then ESPCache[p].box:Destroy() end
                if ESPCache[p].bill then ESPCache[p].bill:Destroy() end
                ESPCache[p] = nil
            end
        end
    end
end)

