-- ========== TARGET LOGIC ==========
local function getHeadPos(character)
    local part = character:FindFirstChild(Config.AimPart)
    return part and part.Position or nil
end

local function isWallBlocked(from, to, character)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = {LocalPlayer.Character, Camera}
    if character then table.insert(exclude, character) end
    params.FilterDescendantsInstances = exclude
    local result = Workspace:Raycast(from, (to - from), params)
    return result ~= nil
end

local function isValid(p)
    if p == LocalPlayer then return false end
    if not p.Character then return false end
    local part = p.Character:FindFirstChild(Config.AimPart)
    if not part then return false end
    local hum = p.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if Config.TeamCheck and p.Team == LocalPlayer.Team then return false end
    return true
end

local function getTarget()
    local center = Config.FOVMode == "Center" and Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2) or Vector2.new(Mouse.X, Mouse.Y)
    local best, bestDist = nil, Config.FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if isValid(p) then
            local pos = getHeadPos(p.Character)
            if pos then
                if not Config.WallCheck or not isWallBlocked(Camera.CFrame.Position, pos, p.Character) then
                    local sp, on = Camera:WorldToViewportPoint(pos)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < bestDist then
                            bestDist = d; best = p
                        end
                    end
                end
            end
        end
    end
    return best
end

local function hitRoll()
    return math.random(1, 100) <= Config.HitChance
end

local function predict(part, hum)
    if Config.Prediction <= 0 then return part.Position end
    local vel = part.AssemblyLinearVelocity
    return part.Position + vel * Config.Prediction
end

-- ========== RAYCAST SILENT AIM ==========
-- Raycast silent aim: casts ray from camera to target, applies aim offset to weapon fire
local function raycastSilent()
    if not Config.SilentAim then return end
    if not hitRoll() then return end
    local target = getTarget()
    if not target or not target.Character then return end
    
    local part = target.Character:FindFirstChild(Config.AimPart)
    if not part then return end
    
    local hum = target.Character:FindFirstChildOfClass("Humanoid")
    local aimPos = predict(part, hum)
    
    -- Raycast from camera to target to confirm line of sight
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera, target.Character}
    local dir = (aimPos - Camera.CFrame.Position)
    local result = Workspace:Raycast(Camera.CFrame.Position, dir, params)
    
    -- If raycast hits something else (wall), abort unless wall check disabled
    if result and Config.WallCheck then return end
    
    -- Apply silent aim via camera CFrame manipulation
    local original = Camera.CFrame
    local newCF = CFrame.new(original.Position, aimPos)
    Camera.CFrame = newCF
    task.wait(0.008)
    Camera.CFrame = original
end

local function cameraSilent()
    if not Config.SilentAim then return end
    if not hitRoll() then return end
    local target = getTarget()
    if not target or not target.Character then return end
    local part = target.Character:FindFirstChild(Config.AimPart)
    if not part then return end
    local hum = target.Character:FindFirstChildOfClass("Humanoid")
    local aimPos = predict(part, hum)
    local orig = Camera.CFrame
    Camera.CFrame = CFrame.new(orig.Position, aimPos)
    task.wait(0.01)
    Camera.CFrame = orig
end

local function doSilent()
    if Config.SilentMode == "Raycast" then
        raycastSilent()
    else
        cameraSilent()
    end
end

-- Aimbot render loop
local aimHeld = false
RunService.RenderStepped:Connect(function(dt)
    if Config.Aimbot and aimHeld then
        local t = getTarget()
        if t and hitRoll() then
            local part = t.Character[Config.AimPart]
            local hum = t.Character:FindFirstChildOfClass("Humanoid")
            local goal = CFrame.new(Camera.CFrame.Position, predict(part, hum))
            Camera.CFrame = Camera.CFrame:Lerp(goal, Config.Smoothness)
        end
    end
    if FOVCircle then
        FOVCircle.Visible = Config.ShowFOV
        updateFOV()
    end
end)

