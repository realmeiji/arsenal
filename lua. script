-- ================= TARGET LOGIC =================
local function getCharacterPart(p) return p.Character and p.Character:FindFirstChild(Config.AimPart) end
local function isValid(p)
    if p == LocalPlayer then return false end
    if not p.Character then return false end
    local part = getCharacterPart(p)
    if not part then return false end
    local hum = p.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if Config.TeamCheck and p.Team == LocalPlayer.Team then return false end
    return true
end
local function raycastVisible(pos, character)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excl = {LocalPlayer.Character, Camera}
    if character then table.insert(excl, character) end
    params.FilterDescendantsInstances = excl
    local hit = Workspace:Raycast(Camera.CFrame.Position, (pos - Camera.CFrame.Position), params)
    return hit == nil
end
local function getTarget()
    local center = Config.FOVMode == "Center" and Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2) or Vector2.new(Mouse.X, Mouse.Y)
    local best, bestDist = nil, Config.FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if isValid(p) then
            local part = getCharacterPart(p)
            local sp, on = Camera:WorldToViewportPoint(part.Position)
            if on then
                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if d < bestDist then
                    if not Config.WallCheck or raycastVisible(part.Position, p.Character) then
                        bestDist = d; best = p
                    end
                end
            end
        end
    end
    return best
end
local function hitRoll() return math.random(1,100) <= Config.HitChance end
local function predict(pos, part) return Config.Prediction > 0 and pos + part.AssemblyLinearVelocity * Config.Prediction or pos end

local function raycastSilent()
    if not hitRoll() then return end
    local target = getTarget()
    if not target then return end
    local part = getCharacterPart(target)
    local aimPos = predict(part.Position, part)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera, target.Character}
    local hit = Workspace:Raycast(Camera.CFrame.Position, (aimPos - Camera.CFrame.Position), params)
    if Config.WallCheck and hit then return end
    local orig = Camera.CFrame
    Camera.CFrame = CFrame.lookAt(orig.Position, aimPos)
    task.wait(0.008)
    Camera.CFrame = orig
    if Config.SilentMethod == "Remote" then
        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then
            local fr = tool:FindFirstChild("Fire") or tool:FindFirstChild("FireServer")
            if fr and fr:IsA("RemoteEvent") then fr:FireServer(aimPos) end
        end
    end
end

local aimHeld = false
RunService.RenderStepped:Connect(function()
    if Config.Aimbot and aimHeld then
        local t = getTarget()
        if t then
            local part = getCharacterPart(t)
            local goal = CFrame.lookAt(Camera.CFrame.Position, predict(part.Position, part))
            Camera.CFrame = Camera.CFrame:Lerp(goal, Config.Smoothness)
        end
    end
    if FOVCircle then FOVCircle.Visible = Config.ShowFOV; updateFOV() end
end)

UserInputService.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.UserInputType == Enum.UserInputType.MouseButton2 or i.KeyCode == Config.AimKey then aimHeld = true end
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        if Config.SilentAim then raycastSilent() end
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton2 or i.KeyCode == Config.AimKey then aimHeld = false end
end)

-- ================= ESP =================
local ESPObjects = {}
local tracerDrawings = {}
local lastESPRender = 0
local espFrameTime = 1 / Config.ESPRenderFPS

local function makeESP(p)
    local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local box = Instance.new("BoxHandleAdornment")
    box.Size = Vector3.new(3,5,1)
    box.Color3 = Config.ESPColor
    box.Transparency = 0.5
    box.AlwaysOnTop = true
    box.Adornee = hrp
    box.Parent = hrp

    local bill = Instance.new("BillboardGui")
    bill.Size = UDim2.new(0, 140, 0, 60)
    bill.Adornee = hrp
    bill.StudsOffset = Vector3.new(0, 3, 0)
    bill.AlwaysOnTop = true
    bill.Parent = hrp

    local name = Instance.new("TextLabel")
    name.Size = UDim2.new(1,0,0.33,0)
    name.BackgroundTransparency = 1
    name.Text = p.Name
    name.TextColor3 = Config.ESPColor
    name.Font = Enum.Font.GothamBold
    name.TextSize = 12
    name.Parent = bill

    local hp = Instance.new("TextLabel")
    hp.Size = UDim2.new(1,0,0.33,0)
    hp.Position = UDim2.new(0,0,0.33,0)
    hp.BackgroundTransparency = 1
    hp.TextColor3 = Color3.fromRGB(255,120,120)
    hp.Font = Enum.Font.Gotham
    hp.TextSize = 10
    hp.Parent = bill

    local dist = Instance.new("TextLabel")
    dist.Size = UDim2.new(1,0,0.34,0)
    dist.Position = UDim2.new(0,0,0.66,0)
    dist.BackgroundTransparency = 1
    dist.TextColor3 = Theme.TextDim
    dist.Font = Enum.Font.Gotham
    dist.TextSize = 9
    dist.Parent = bill

    ESPObjects[p] = {box = box, bill = bill, name = name, hp = hp, dist = dist, hrp = hrp}
end

local function clearESP()
    for _, v in pairs(ESPObjects) do
        if v.box then v.box:Destroy() end
        if v.bill then v.bill:Destroy() end
    end
    ESPObjects = {}
    for _, t in pairs(tracerDrawings) do if t then t:Remove() end end
    tracerDrawings = {}
end

RunService.Heartbeat:Connect(function()
    if not Config.ESP then
        if next(ESPObjects) then clearESP() end
        return
    end
    local now = tick()
    if now - lastESPRender < espFrameTime then return end
    lastESPRender = now
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if not ESPObjects[p] then makeESP(p) end
            local e = ESPObjects[p]
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local hrp = p.Character.HumanoidRootPart
            local camPos = Camera.CFrame.Position
            local sp, on = Camera:WorldToViewportPoint(hrp.Position)
            local distFromCam = (hrp.Position - camPos).Magnitude
            local visible = on and sp.Z > 0 and distFromCam <= Config.ESPMaxDistance
            if e.box then e.box.Visible = visible and Config.ESPBox end
            if e.bill then e.bill.Enabled = visible end
            if e.name then e.name.Visible = Config.ESPName end
            if e.hp and hum then e.hp.Visible = Config.ESPHealth; e.hp.Text = math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) end
            if e.dist then e.dist.Visible = Config.ESPDistance; e.dist.Text = math.floor(distFromCam) .. " studs" end
            if Config.ESPTracer and visible and Drawing and Drawing.new then
                if not tracerDrawings[p] then tracerDrawings[p] = Drawing.new("Line") end
                local line = tracerDrawings[p]
                line.Visible = true
                line.Color = Config.ESPColor
                line.Thickness = 1
                line.Transparency = 0.7
                line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                line.To = Vector2.new(sp.X, sp.Y)
            elseif tracerDrawings[p] then
                tracerDrawings[p].Visible = false
            end
        else
            if ESPObjects[p] then
                if ESPObjects[p].box then ESPObjects[p].box:Destroy() end
                if ESPObjects[p].bill then ESPObjects[p].bill:Destroy() end
                ESPObjects[p] = nil
            end
            if tracerDrawings[p] then tracerDrawings[p]:Remove(); tracerDrawings[p] = nil end
        end
    end
end)

